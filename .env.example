# Copy to .env and fill in. Never commit .env.
#
# The defaults below are the DOCKER-FREE development profile: a locally
# installed PostgreSQL, an in-process queue, files on local disk and email
# written to a folder you can open. Nothing else needs to be running.
#
# See SETUP-WINDOWS.md for the two things you do have to install.

# ─────────────────────────────── runtime ───────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
APP_TZ=Asia/Kolkata
LOG_LEVEL=info

# ─────────────────────────────── database ───────────────────────────────
# Locally installed PostgreSQL 16. If you used the installer's default
# superuser instead of a dedicated role, this becomes:
#   postgresql://postgres:<your password>@localhost:5432/mom_tracker?schema=public
DATABASE_URL=postgresql://ucf:ucf_dev_only@localhost:5432/mom_tracker?schema=public

# ──────────────────────────────── auth ────────────────────────────────
# Any long random strings for development. Generate real ones for anything else:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ──────────────────────────────── queue ────────────────────────────────
# memory: runs in process, loses anything queued on restart — development only.
# bullmq: needs REDIS_URL. Required in production; the app refuses to start
#         in production with the memory driver.
QUEUE_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────── branding ───────────────────────────────
# The state emblem printed at the head of every MoM. Drop the official file
# at var/branding/emblem.png (PNG, SVG or JPEG) or point this somewhere else.
# Without it the masthead prints without a crest — never a placeholder, on a
# document that goes on the record.
# MOM_EMBLEM_PATH=./var/branding/emblem.png
# The CDMA roundel, printed opposite the state emblem. Same search: drop the
# file at var/branding/cdma.png or point this somewhere else. Each crest is
# independent — with one file and not the other the masthead stays balanced.
# MOM_CDMA_LOGO_PATH=./var/branding/cdma.png

# The PDF is produced by printing the document with a browser that is already
# on the machine — nothing is bundled. Windows uses Edge, Linux uses chromium.
# Set this only if one is installed somewhere unusual.
# MOM_BROWSER_PATH=

# ─────────────────────────────── storage ───────────────────────────────
# local: writes under LOCAL_STORAGE_DIR — development only. Production refuses
# to start with anything but s3, because the instance filesystem is replaced on
# every deployment and nothing would notice the documents were gone.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/files
# S3_REGION=ap-south-2
# S3_BUCKET=ucf-mom-files
# S3_PREFIX=files
# S3_SSE=AES256
# S3_KMS_KEY_ID=
# Only for an S3-compatible store such as MinIO. Leave unset for AWS.
# S3_ENDPOINT=
# The fallback, not the plan. On EC2 leave both unset and attach an instance
# role: a role rotates itself and cannot be pasted into a chat message.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where deploy/backup.sh uploads the nightly dump. Same bucket, different
# prefix — and the instance role may write there but not delete.
# BACKUP_S3_URI=s3://ucf-mom-files/backups

# ──────────────────────────────── email ────────────────────────────────
# DECIDED: WhatsApp only. Email is deferred, not cancelled — the notification
# events are channel-agnostic, so adding it later touches no state machine.
# none:    nothing is sent and nothing is written. This is the server setting.
# console: writes .eml files to EMAIL_OUTBOX_DIR — development only, and
#          production refuses to start with it.
# smtp:    any SMTP server, including a local catcher.
EMAIL_PROVIDER=console
EMAIL_FROM="UCF Tracker <no-reply@example.gov>"
EMAIL_OUTBOX_DIR=./var/mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─────────────────────────────── whatsapp ───────────────────────────────
# Indian aggregator, Gupshup as the reference adapter. Templates must be
# pre-approved by Meta before they will send; see docs/06-NOTIFICATIONS.md.
WHATSAPP_PROVIDER=console
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=
# GUPSHUP_APP_NAME=
# WEBHOOK_HMAC_SECRET=
